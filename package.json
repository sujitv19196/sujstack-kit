{
  "name": "sujstack-kit",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "ports/*",
    "adapters/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun test",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "latest",
    "typescript": "7.0.2"
  }
}
